# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Environment / secrets
.env
.env.*
!.env.example

# Build & dependency output
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# Raw word-data downloads (re-fetch with scripts/fetch_raw.sh).
# Committed: Nation basewrd1-6.txt (small, free for personal/research use) and data/raw/SOURCES.md.
# Ignored: large originals and redistributable-unclear files; their slim extracts live in data/extract/.
data/raw/**/*.zip
data/raw/**/*.xlsx
data/raw/**/*.pdf
data/raw/**/*.html
data/raw/**/*.dat
data/raw/**/*.gz

# Regenerated by scripts/extract_raw.py, build_bands.py and build_dict.py
data/extract/
data/dropped.txt

# British Lexicon Project: only license.txt is committed; the 5 MB items table is re-fetched
data/raw/blp/*.txt
!data/raw/blp/license.txt

# Design canvases: keep the artboard sources, not the 2 MB assembled pages
design/**/*.html
!design/**/*.dc.html

# Anki exports from the Learn page and scripts/export_anki.py (<date>.txt, <subband>.txt, my-words.txt):
# regenerated on demand, not tracked
vocab/decks/
